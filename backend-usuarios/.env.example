# PostgreSQL local o Neon. En Neon, agrega ?sslmode=require a la URL JDBC.
DATABASE_URL=jdbc:postgresql://HOST/BASE?sslmode=require
DATABASE_USERNAME=USUARIO
DATABASE_PASSWORD=CONTRASENA

# Genera una clave Base64 aleatoria de al menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

FRONTEND_ORIGIN=http://localhost:5173
SERVER_PORT=8080
DDL_AUTO=update

# Opcionales. Si se configuran, crea una cuenta DIRECTIVA inicial una sola vez.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
