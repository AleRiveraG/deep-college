# PostgreSQL local o Neon (mismos valores que backend-usuarios). En Neon agrega ?sslmode=require a la URL.
DATABASE_URL=jdbc:postgresql://HOST/BASE?sslmode=require
DATABASE_USERNAME=USUARIO
DATABASE_PASSWORD=CONTRASENA

# DEBE ser exactamente el mismo JWT_SECRET que usa backend-usuarios.
JWT_SECRET=

FRONTEND_ORIGIN=http://localhost:5173
SERVER_PORT=8082
